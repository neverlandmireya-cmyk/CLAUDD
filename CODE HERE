        accounts = req.accounts or config["accounts"]
        if not accounts:
            log_task(task_id, "No hay cuentas")
            active_tasks[task_id]["status"] = "error"
            return
        phone = accounts[0]
        client = await safe_client(phone)
        if not client:
            log_task(task_id, "No pudo conectar (DB locked)")
            active_tasks[task_id]["status"] = "error"
            return
        try:
            async for _ in client.get_dialogs():
                pass
            peer = await find_peer(client, req.group_id)
            if not peer:
                log_task(task_id, "Grupo no encontrado")
                active_tasks[task_id]["status"] = "error"
                return
            created = 0
            for i in range(1, req.count + 1):
                ok = False
                for intento in range(3):
                    try:
                        await client.invoke(raw.functions.channels.CreateForumTopic(
                            channel=peer, title=req.title,
                            random_id=random.randint(1, 2**31),
                            icon_color=0x6FB9F0
