@app.post("/api/accounts/send-code")
async def send_code(req: PhoneRequest, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    phone = req.phone.strip()
    try:
        # Si ya tiene sesion, verificar si esta logueado
        client = await safe_client(phone)
        if client:
            try:
                me = await client.get_me()
                await safe_disconnect(client)
                return {"ok": True, "already_logged": True, "name": me.first_name}
            except:
                await safe_disconnect(client)
        # No tiene sesion o no esta logueado - enviar codigo
        client2 = Client(session_path(phone), api_id=API_ID, api_hash=API_HASH, no_updates=True)
        await client2.connect()
        sent = await client2.send_code(phone)
        pending_logins[phone] = {"client": client2, "phone_code_hash": sent.phone_code_hash}
        return {"ok": True, "already_logged": False, "message": "Codigo enviado"}
    except Exception as e:
        return {"ok": False, "error": str(e)}

@app.post("/api/accounts/verify")
async def verify_code(req: VerifyRequest, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    phone = req.phone.strip()
    if phone not in pending_logins:
        raise HTTPException(400, "No hay login pendiente")
    ld = pending_logins[phone]
    client = ld["client"]
    try:
        try:
            await client.sign_in(phone, ld["phone_code_hash"], req.code)
        except errors.SessionPasswordNeeded:
            if req.password:
                await client.check_password(req.password)
            else:
                return {"ok": False, "needs_2fa": True}
        me = await client.get_me()
        try: await client.disconnect()
        except: pass
        del pending_logins[phone]
        config = load_config()
        if phone not in config["accounts"]:
            config["accounts"].append(phone)
            save_config(config)
        return {"ok": True, "name": me.first_name}
    except Exception as e:
        return {"ok": False, "error": str(e)}

