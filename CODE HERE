_global_lock = asyncio.Lock()

def load_config():
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE) as f:
            data = json.load(f)
        if "owners" not in data:
            data["owners"] = []
            save_config(data)
        return data
    default = {"accounts": [], "owners": []}
    save_config(default)
    return default

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=2)

def verify_key(x_api_key: str = Header(None)):
    if x_api_key != API_KEY:
        raise HTTPException(status_code=401, detail="API key invalida")

def session_path(phone):
    return SESSIONS_DIR + "/" + phone.replace("+", "").replace(" ", "")

def new_task_id():
    global task_counter
    task_counter += 1
    return "task_" + str(task_counter) + "_" + str(int(time.time()))

def log_task(task_id, msg):
    ts = datetime.now().strftime("%H:%M:%S")
    entry = "[" + ts + "] " + msg
    if task_id in active_tasks:
        active_tasks[task_id]["logs"].append(entry)
    print(entry)

async def safe_client(phone):
    sp = session_path(phone) + ".session"
    if not os.path.exists(sp):
        return None
    await _global_lock.acquire()
    try:
        c = Client(session_path(phone), api_id=API_ID, api_hash=API_HASH, no_updates=True)
        await c.connect()
        me = await c.get_me()
        if me:
            print("[OK] " + phone + " conectado")
            return c
        print("[WARN] " + phone + " sin sesion valida")
        await c.disconnect()
    except Exception as e:
        print("[ERR] " + phone + ": " + str(e))
    try: _global_lock.release()
    except: pass
    return None

async def safe_disconnect(client):
    try: await client.disconnect()
    except: pass
    try: _global_lock.release()
    except: pass

async def find_peer(c, chat_id):
    count = 0
    async for d in c.get_dialogs():
        if d.chat.id == chat_id:
            return await c.resolve_peer(d.chat.id)
        count += 1
        if count > 500:
            break
    return None

async def get_topic_messages(c, peer, topic_id):
    msg_ids = []
    offset_id = 0
    while True:
        try:
            result = await c.invoke(raw.functions.messages.Search(
                peer=peer, q="", filter=raw.types.InputMessagesFilterEmpty(),
                min_date=0, max_date=0, offset_id=offset_id,
                add_offset=0, limit=100, max_id=0, min_id=0, hash=0, top_msg_id=topic_id
            ))
        except:
            break
        if not result.messages:
            break
        for m in result.messages:
            msg_ids.append(m.id)
        offset_id = result.messages[-1].id
        if len(result.messages) < 100:
            break
    if not msg_ids:
        offset_id = 0
        while True:
            try:
                result = await c.invoke(raw.functions.messages.GetReplies(
                    peer=peer, msg_id=topic_id, offset_id=offset_id,
                    offset_date=0, add_offset=0, limit=100,
                    max_id=0, min_id=0, hash=0
                ))
            except:
                break
            if not result.messages:
                break
            for m in result.messages:
                msg_ids.append(m.id)
            offset_id = result.messages[-1].id
            if len(result.messages) < 100:
                break
    return msg_ids

async def scan_all_messages(client, peer, filter_type, task_id):
    msg_ids = []
    offset_id = 0
    log_task(task_id, "Escaneando con GetHistory...")
    while True:
        try:
            result = await client.invoke(raw.functions.messages.GetHistory(
                peer=peer, offset_id=offset_id, offset_date=0,
                add_offset=0, limit=100, max_id=0, min_id=0, hash=0
            ))
        except Exception as e:
            log_task(task_id, "Error scan: " + str(e))
            break
        if not result.messages:
            break
        for m in result.messages:
            has_media = hasattr(m, "media") and m.media is not None
            mt = type(m.media).__name__ if has_media else ""
            is_photo = "Photo" in mt
            is_video = "Document" in mt or "Video" in mt
            if filter_type == "all":
                msg_ids.append(m.id)
            elif filter_type == "photos" and is_photo:
                msg_ids.append(m.id)
            elif filter_type == "videos" and is_video:
                msg_ids.append(m.id)
            elif filter_type == "media" and (is_photo or is_video):
                msg_ids.append(m.id)
            elif filter_type == "all_media" and has_media:
                msg_ids.append(m.id)
            elif filter_type == "text" and not has_media:
                msg_ids.append(m.id)
        offset_id = result.messages[-1].id
        if len(result.messages) < 100:
            break
    log_task(task_id, "Total escaneado: " + str(len(msg_ids)))
    return msg_ids

async def forward_lote(cl, o_peer, d_peer, lote, drop_author, task_id, ph, env, total, top_msg_id=None):
    try:
        rids = [random.randint(1, 2**63) for _ in lote]
        fa = {"from_peer": o_peer, "id": lote, "to_peer": d_peer, "random_id": rids}
        if drop_author:
            fa["drop_author"] = True
        if top_msg_id:
            fa["top_msg_id"] = top_msg_id
        await cl.invoke(raw.functions.messages.ForwardMessages(**fa))
        return len(lote), 0, False
    except Exception as e:
        es = str(e)
        if "FLOOD" in es.upper() or "Waiting" in es:
            try:
                w = int(es.split("of ")[1].split(" ")[0])
            except:
                w = 30
            if w > 60:
                log_task(task_id, "[" + ph + "] FloodWait " + str(w) + "s - SALTANDO a siguiente cuenta")
                return 0, len(lote), True
            log_task(task_id, "[" + ph + "] FloodWait " + str(w) + "s...")
            await asyncio.sleep(w)
            try:
                rids = [random.randint(1, 2**63) for _ in lote]
                fa["random_id"] = rids
                await cl.invoke(raw.functions.messages.ForwardMessages(**fa))
                return len(lote), 0, False
            except:
                return 0, len(lote), True
        elif "MEDIA" in es.upper():
            ok = 0
            fail = 0
            for mid in lote:
                try:
                    rid = [random.randint(1, 2**63)]
                    fa2 = {"from_peer": o_peer, "id": [mid], "to_peer": d_peer, "random_id": rid}
                    if drop_author:
                        fa2["drop_author"] = True
                    await cl.invoke(raw.functions.messages.ForwardMessages(**fa2))
                    ok += 1
                except:
                    fail += 1
                await asyncio.sleep(0.5)
            return ok, fail, False
        else:
            log_task(task_id, "[" + ph + "] Error: " + es)
            return 0, len(lote), False

