                active_tasks[task_id]["progress"] = i
                await asyncio.sleep(3)
        finally:
            await safe_disconnect(client)
        active_tasks[task_id]["status"] = "done"
        log_task(task_id, "LISTO - " + str(created) + "/" + str(req.count))
    asyncio.create_task(run())
    return {"ok": True, "task_id": task_id}

@app.get("/api/topics/{group_id}")
async def scan_topics(group_id: int, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    config = load_config()
    if not config["accounts"]:
        raise HTTPException(400, "No hay cuentas")
    phone = config["accounts"][0]
    client = await safe_client(phone)
    if not client:
        raise HTTPException(500, "No se pudo conectar (database locked)")
    try:
        async for _ in client.get_dialogs():
            pass
        peer = await find_peer(client, group_id)
        if not peer:
            raise HTTPException(404, "Grupo no encontrado")
        result = await client.invoke(raw.functions.channels.GetForumTopics(
            channel=peer, offset_date=0, offset_id=0, offset_topic=0, limit=100
        ))
        topics = []
        for t in result.topics:
            if type(t).__name__ == "ForumTopicDeleted":
                continue
            if getattr(t, "hidden", False):
                continue
            msgs = await get_topic_messages(client, peer, t.id)
            topics.append({"id": t.id, "title": t.title, "messages": len(msgs), "is_general": t.id == 1})
    finally:
        await safe_disconnect(client)
    return {"topics": topics, "total": len(topics)}

@app.post("/api/clone-topics")
async def clone_topics(req: CloneTopicsRequest, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    task_id = new_task_id()
    active_tasks[task_id] = {"status": "running", "progress": 0, "total": 0, "logs": [], "type": "clone_topics"}
    async def run():
        config = load_config()
        accounts = req.accounts or config["accounts"]
        if not accounts:
            log_task(task_id, "No hay cuentas")
            active_tasks[task_id]["status"] = "error"
            return
        phone = accounts[0]
        client = await safe_client(phone)
        if not client:
            log_task(task_id, "No pudo conectar (DB locked)")
            active_tasks[task_id]["status"] = "error"
            return
        topic_map = []
        try:
            async for _ in client.get_dialogs():
                pass
            op = await find_peer(client, req.origen)
            dp = await find_peer(client, req.destino)
            if not op or not dp:
                log_task(task_id, "No se encontraron los grupos")
                active_tasks[task_id]["status"] = "error"
                return
            result = await client.invoke(raw.functions.channels.GetForumTopics(
                channel=op, offset_date=0, offset_id=0, offset_topic=0, limit=100
            ))
            topics = [t for t in result.topics if type(t).__name__ != "ForumTopicDeleted" and not getattr(t, "hidden", False)]
            if req.topic_indices:
                chosen = [topics[i] for i in req.topic_indices if 0 <= i < len(topics)]
            else:
                chosen = topics
            log_task(task_id, "Clonando " + str(len(chosen)) + " topics...")
            for topic in chosen:
                if topic.id == 1:
                    topic_map.append((topic, 1))
                else:
                    try:
                        ic = getattr(topic, "icon_color", None) or 0x6FB9F0
                        nr = await client.invoke(raw.functions.channels.CreateForumTopic(
                            channel=dp, title=topic.title,
                            random_id=random.randint(1, 2**31), icon_color=ic
                        ))
                        topic_map.append((topic, nr.updates[1].message.id))
                        log_task(task_id, "Topic \"" + topic.title + "\" creado")
                    except Exception as e:
                        log_task(task_id, "Error: " + str(e))
                    await asyncio.sleep(2)
        finally:
            await safe_disconnect(client)
        active_tasks[task_id]["total"] = len(topic_map)
        at = {}
        for idx, (topic, ntid) in enumerate(topic_map):
            ph = accounts[idx % len(accounts)]
            if ph not in at:
                at[ph] = []
            at[ph].append((topic, ntid))
        te = 0
        tf = 0
        progress = 0
        for ph, pt in at.items():
            log_task(task_id, "--- Cuenta " + ph + " ---")
            cl = await safe_client(ph)
            if not cl:
                log_task(task_id, "[" + ph + "] No pudo conectar (DB locked)")
                continue
            try:
                async for _ in cl.get_dialogs():
                    pass
                o_peer = await find_peer(cl, req.origen)
                d_peer = await find_peer(cl, req.destino)
                if not o_peer or not d_peer:
                    log_task(task_id, "[" + ph + "] Grupo no encontrado")
                    continue
                for topic, ntid in pt:
                    title = topic.title
                    mids = await get_topic_messages(cl, o_peer, topic.id)
                    mids.reverse()
                    if not mids:
                        progress += 1
                        active_tasks[task_id]["progress"] = progress
                        continue
                    env = 0
                    fal = 0
                    for i in range(0, len(mids), 50):
                        lote = mids[i:i+50]
                        e, f, _flood = await forward_lote(cl, o_peer, d_peer, lote, req.drop_author, task_id, ph, env, len(mids), top_msg_id=ntid)
                        env += e
                        fal += f
                        active_tasks[task_id]["progress"] = progress
                        log_task(task_id, "[" + ph + "] \"" + title + "\" - " + str(env) + "/" + str(len(mids)))
                        await asyncio.sleep(2)
                    te += env
                    tf += fal
                    progress += 1
            except Exception as e:
                log_task(task_id, "[" + ph + "] Error: " + str(e))
            finally:
                await safe_disconnect(cl)
        active_tasks[task_id]["status"] = "done"
        log_task(task_id, "RESUMEN: Enviados " + str(te) + " | Fallos " + str(tf))
    asyncio.create_task(run())
    return {"ok": True, "task_id": task_id}

@app.post("/api/forward")
async def forward_media(req: ForwardRequest, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    task_id = new_task_id()
    active_tasks[task_id] = {"status": "running", "progress": 0, "total": 0, "logs": [], "type": "forward"}
    async def run():
      try:
        config = load_config()
        accounts = req.accounts or config["accounts"]
        phone = accounts[0]
        log_task(task_id, "Escaneando con cuenta: " + phone)
        client = Client(session_path(phone), api_id=API_ID, api_hash=API_HASH, no_updates=True)
        async with client:
            log_task(task_id, "Conectado, cargando chats...")
            async for _ in client.get_dialogs():
                pass
            peer_scan = await find_peer(client, req.origen)
            if not peer_scan:
                log_task(task_id, "Canal origen no encontrado")
                active_tasks[task_id]["status"] = "error"
                return
            media_ids = await scan_all_messages(client, peer_scan, req.filter_type, task_id)
        media_ids.reverse()
        total = len(media_ids)
        active_tasks[task_id]["total"] = total
        if not total:
            active_tasks[task_id]["status"] = "done"
            log_task(task_id, "No hay mensajes para reenviar")
            return
        pos = 0
        te = 0
        tf = 0
        for ph in accounts:
            if pos >= total:
                break
            try:
                cl = Client(session_path(ph), api_id=API_ID, api_hash=API_HASH, no_updates=True)
                async with cl:
                    async for _ in cl.get_dialogs():
                        pass
                    o_peer = await find_peer(cl, req.origen)
                    d_peer = await find_peer(cl, req.destino)
                    if not o_peer or not d_peer:
                        log_task(task_id, "[" + ph + "] No encontro canales")
                        continue
                    flooded = False
                    while pos < total and not flooded:
                        lote = media_ids[pos:pos+50]
                        e, f, flood = await forward_lote(cl, o_peer, d_peer, lote, req.drop_author, task_id, ph, te, total)
                        if flood:
                            flooded = True
                            break
                        te += e
                        tf += f
                        pos += len(lote)
                        active_tasks[task_id]["progress"] = te
                        log_task(task_id, "[" + ph + "] Enviados " + str(te) + "/" + str(total))
                        await asyncio.sleep(2)
                if flooded:
                    log_task(task_id, "[" + ph + "] bloqueada, pasando a siguiente...")
            except Exception as ex:
                log_task(task_id, "[" + ph + "] Error: " + str(ex))
        if pos < total:
            log_task(task_id, "AVISO: " + str(total - pos) + " mensajes pendientes")
        active_tasks[task_id]["status"] = "done"
        log_task(task_id, "RESUMEN: Enviados " + str(te) + " | Fallos " + str(tf))
      except Exception as e:
        log_task(task_id, "ERROR FATAL: " + str(e))
        active_tasks[task_id]["status"] = "error"
    asyncio.create_task(run())
    return {"ok": True, "task_id": task_id}

@app.get("/api/tasks")
async def list_tasks(x_api_key: str = Header(None)):
    verify_key(x_api_key)
    return {"tasks": {k: {**v, "logs": v["logs"][-20:]} for k, v in active_tasks.items()}}

@app.get("/api/tasks/{task_id}")
async def get_task(task_id: str, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    if task_id not in active_tasks:
        raise HTTPException(404, "Task no encontrada")
    return active_tasks[task_id]

@app.delete("/api/tasks/{task_id}")
async def delete_task(task_id: str, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    if task_id in active_tasks:
        del active_tasks[task_id]
    return {"ok": True}

