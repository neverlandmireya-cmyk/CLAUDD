@app.post("/api/promote")
async def promote_accounts(req: PromoteRequest, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    task_id = new_task_id()
    active_tasks[task_id] = {"status": "running", "progress": 0, "total": 0, "logs": [], "type": "promote"}
    async def run():
        config = load_config()
        accounts = req.accounts or config["accounts"]
        active_tasks[task_id]["total"] = len(accounts)
        # Paso 1: obtener user_id de cada cuenta
        user_ids = {}
        for phone in accounts:
            client = await safe_client(phone)
            if not client:
                log_task(task_id, phone + " - No pudo conectar")
                continue
            try:
                me = await client.get_me()
                user_ids[phone] = me.id
                log_task(task_id, phone + " - ID: " + str(me.id))
            except Exception as e:
                log_task(task_id, phone + " - Error obteniendo ID: " + str(e))
            finally:
                await safe_disconnect(client)
            await asyncio.sleep(2)
        if not user_ids:
            log_task(task_id, "No se pudo obtener ningun ID")
            active_tasks[task_id]["status"] = "error"
            return
        # Paso 2: conectar owner y buscar usuarios en el grupo
        owner = await safe_client(req.owner_phone)
        if not owner:
            log_task(task_id, "Cuenta dueno no pudo conectar")
            active_tasks[task_id]["status"] = "error"
            return
        try:
            async for _ in owner.get_dialogs():
                pass
            peer = await find_peer(owner, req.group_id)
            if not peer:
                log_task(task_id, "Grupo no encontrado con cuenta dueno")
                active_tasks[task_id]["status"] = "error"
                return
            # Buscar miembros del grupo para obtener access_hash
            log_task(task_id, "Buscando miembros del grupo...")
            members = {}
            offset = 0
            while True:
                try:
                    result = await owner.invoke(raw.functions.channels.GetParticipants(
                        channel=peer,
                        filter=raw.types.ChannelParticipantsRecent(),
                        offset=offset,
                        limit=200,
                        hash=0
                    ))
                    if not result.users:
                        break
                    for u in result.users:
                        members[u.id] = raw.types.InputUser(user_id=u.id, access_hash=u.access_hash)
                    offset += len(result.participants)
                    if len(result.participants) < 200:
                        break
                except Exception as e:
                    log_task(task_id, "Error buscando miembros: " + str(e))
                    break
            log_task(task_id, "Encontrados " + str(len(members)) + " miembros")
            # Paso 3: promover
            success = 0
            for i, (phone, uid) in enumerate(user_ids.items()):
                try:
                    if uid in members:
                        user_peer = members[uid]
                    else:
                        log_task(task_id, phone + " - No encontrado en el grupo, intentando directo...")
                        try:
                            user_peer = await owner.resolve_peer(uid)
                        except:
                            log_task(task_id, phone + " - Error: usuario no encontrado en el grupo")
                            active_tasks[task_id]["progress"] = i + 1
                            continue
                    await owner.invoke(raw.functions.channels.EditAdmin(
                        channel=peer,
                        user_id=user_peer,
                        admin_rights=raw.types.ChatAdminRights(
                            change_info=True,
                            post_messages=True,
                            edit_messages=True,
                            delete_messages=True,
                            ban_users=True,
                            invite_users=True,
                            pin_messages=True,
                            manage_topics=True,
                            manage_call=True,
                            other=True
                        ),
                        rank=""
                    ))
                    log_task(task_id, phone + " - ADMIN OK")
                    success += 1
                except Exception as e:
                    log_task(task_id, phone + " - Error: " + str(e))
                active_tasks[task_id]["progress"] = i + 1
                await asyncio.sleep(3)
        finally:
            await safe_disconnect(owner)
        active_tasks[task_id]["status"] = "done"
        log_task(task_id, "LISTO - " + str(success) + "/" + str(len(user_ids)) + " promovidos")
    asyncio.create_task(run())
    return {"ok": True, "task_id": task_id}

@app.post("/api/join")
async def join_all(req: JoinRequest, x_api_key: str = Header(None)):
    verify_key(x_api_key)
    task_id = new_task_id()
    active_tasks[task_id] = {"status": "running", "progress": 0, "total": 0, "logs": [], "type": "join"}
    async def run():
        config = load_config()
        accounts = req.accounts or config["accounts"]
        active_tasks[task_id]["total"] = len(accounts)
        ih = None
        match = re.search(r"t\.me/\+([a-zA-Z0-9_-]+)", req.link)
        if match:
            ih = match.group(1)
        if not ih:
            match = re.search(r"t\.me/joinchat/([a-zA-Z0-9_-]+)", req.link)
            if match:
                ih = match.group(1)
        success = 0
        for i, phone in enumerate(accounts):
            client = None
            try:
                client = await safe_client(phone)
                if not client:
                    log_task(task_id, phone + " - Error: no pudo conectar (DB locked)")
                    active_tasks[task_id]["progress"] = i + 1
                    await asyncio.sleep(5)
                    continue
                if ih:
                    await client.invoke(raw.functions.messages.ImportChatInvite(hash=ih))
                else:
                    await client.join_chat(req.link)
                me = await client.get_me()
                log_task(task_id, phone + " - UNIDO (" + me.first_name + ")")
                success += 1
            except Exception as e:
                if "already" in str(e).lower():
                    log_task(task_id, phone + " - Ya estaba dentro")
                    success += 1
                else:
                    log_task(task_id, phone + " - Error: " + str(e))
            finally:
                if client:
                    await safe_disconnect(client)
            active_tasks[task_id]["progress"] = i + 1
            await asyncio.sleep(5)
        active_tasks[task_id]["status"] = "done"
        log_task(task_id, "LISTO - " + str(success) + "/" + str(len(accounts)))
    asyncio.create_task(run())
    return {"ok": True, "task_id": task_id}

